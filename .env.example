# OpenAI-compatible model provider.
# For OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# For DeepSeek:
# DEEPSEEK_API_KEY=...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Web search via Tavily.
# TAVILY_API_KEY=tvly-...

# TypeSafe Jev evidence selection (topic/search requests only).
# TYPESAFE_API_KEY=...
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=  # optional custom base URL

# LangSmith tracing is optional but recommended while building agents.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-summarizer-agent
