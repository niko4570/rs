# OpenAI-compatible model provider.
# For OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# For DeepSeek:
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Web search via Tavily.
# TAVILY_API_KEY=tvly-...

# TypeSafe Jev evidence selection (topic/search requests only).
# TYPESAFE_API_KEY=...
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=  # optional custom base URL

# LangSmith tracing is optional but recommended while building agents.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-summarizer-agent

# Search evidence cleaning: off | structure (L0, default) | edges (L0+L1) | all (L0+L2+L1).
# EVIDENCE_CLEANING=structure

# Synthesis output: json_object (default) | json_schema (requires endpoint support).
# OPENAI_OUTPUT_FORMAT=json_object
